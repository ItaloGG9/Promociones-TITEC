{
  "info": {
    "_postman_id": "promociones-titec-pruebas-sistema",
    "name": "Promociones TITEC - Pruebas del Sistema",
    "description": "Pruebas del sistema del microservicio de Promociones.\n\nRequisitos: backend corriendo (`npm start` en backend-promociones) con MongoDB.\nEjecutar la colección completa en orden con el Collection Runner (o `newman run`). Cada ejecución genera códigos y eventos únicos, así que no depende del seed ni hay que limpiar la BD.\n\nCambiar la variable `baseUrl` si el servicio no corre en http://localhost:3005.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run') || pm.info.requestName.startsWith('1.1')) {",
          "  const run = Date.now().toString(36).toUpperCase();",
          "  const DAY = 24 * 60 * 60 * 1000;",
          "  const now = Date.now();",
          "  const v = {",
          "    run,",
          "    id_evento: 'evt-pm-' + run,",
          "    id_evento_sin_promo: 'evt-sin-promo-' + run,",
          "    codigo_vigente: 'PM' + run,",
          "    codigo_vigente_min: ('PM' + run).toLowerCase(),",
          "    codigo_grupo: 'GRUPO' + run,",
          "    codigo_expirado: 'EXP' + run,",
          "    codigo_invalido: 'INV' + run,",
          "    usuario_a: 'usr-a-' + run,",
          "    usuario_b: 'usr-b-' + run,",
          "    usuario_c: 'usr-c-' + run,",
          "    fecha_ayer: new Date(now - DAY).toISOString(),",
          "    fecha_mes: new Date(now + 30 * DAY).toISOString(),",
          "    fecha_dos_meses: new Date(now + 60 * DAY).toISOString(),",
          "  };",
          "  Object.entries(v).forEach(([k, val]) => pm.collectionVariables.set(k, val));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005"
    }
  ],
  "item": [
    {
      "name": "1. HU-01 Crear promoción",
      "item": [
        {
          "name": "1.1 Crear promoción vigente (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promociones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "promociones"
              ]
            },
            "description": "Se envía el código en minúsculas para verificar que se normaliza a MAYÚSCULAS.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_codigo\": \"{{codigo_vigente_min}}\",\n  \"id_evento\": \"{{id_evento}}\",\n  \"porcentaje_descuento\": 20,\n  \"fecha_inicio\": \"{{fecha_ayer}}\",\n  \"fecha_fin\": \"{{fecha_mes}}\",\n  \"cantidad_codigos\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Responde en menos de 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const p = pm.response.json();",
                  "pm.test('Retorna _id', () => pm.expect(p._id).to.be.a('string'));",
                  "pm.test('Código guardado en MAYÚSCULAS', () => pm.expect(p.nombre_codigo).to.eql(pm.collectionVariables.get('codigo_vigente')));",
                  "pm.test('Valores por defecto (activo, usos, mínimos)', () => {",
                  "  pm.expect(p.activo).to.eql(true);",
                  "  pm.expect(p.usos_actuales).to.eql(0);",
                  "  pm.expect(p.minimo_entradas).to.eql(1);",
                  "  pm.expect(p.max_usos_por_cuenta).to.eql(1);",
                  "});",
                  "pm.collectionVariables.set('id_vigente', p._id);"
                ]
              }
            }
          ]
        },
