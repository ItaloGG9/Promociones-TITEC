{
  "info": {
    "_postman_id": "378e82e8-d3df-5f2b-badc-211ec65a933b",
    "name": "Promociones - Integraciones en workstation",
    "description": "Pruebas de integración del módulo Promociones contra los servicios reales de workstation: I1 Auth, I2 API Gateway (servicio consumido por Entradas) e I3 Broker (evento pago.completado de Pagos). Use el environment promociones_workstation.postman_environment.json. Ver tests/README_PRUEBAS_POSTMAN.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación",
      "description": "Comprueba que Promociones está arriba, genera datos únicos e inicia sesión en Auth con dos cuentas reales de workstation (organizador y comprador).",
      "item": [
        {
          "name": "0.1 Promociones conectado a MongoDB (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos únicos por ejecución: código nuevo y fechas relativas a hoy",
                  "const sufijo = Date.now().toString(36).toUpperCase();",
                  "const dia = 24 * 60 * 60 * 1000;",
                  "pm.collectionVariables.set('codigo', 'WS' + sufijo);",
                  "pm.collectionVariables.set('fecha_inicio', new Date(Date.now() - 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('fecha_fin', new Date(Date.now() + 30 * dia).toISOString());",
                  "pm.collectionVariables.set('fecha_fin_extendida', new Date(Date.now() + 60 * dia).toISOString());",
                  "pm.collectionVariables.set('fecha_pasada', new Date(Date.now() - 2 * dia).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Servicio de Promociones responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Base de datos conectada', () => pm.expect(pm.response.json().base_datos).to.eql('conectada'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{promocionesUrl}}/health"
          }
        },
        {
          "name": "0.2 Login organizador en Auth (200 + cookie jwt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso (200)', () => pm.response.to.have.status(200));",
                  "const sc = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
                  "const jwt = (sc.match(/jwt=([^;]+)/) || [])[1] || (pm.response.cookies.get && pm.response.cookies.get('jwt'));",
                  "pm.test('Auth entrega la cookie de sesión jwt', () => pm.expect(jwt, 'cookie jwt').to.be.a('string').and.not.empty);",
                  "if (jwt) pm.collectionVariables.set('jwt_organizador', jwt);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_organizador}}\",\n  \"password\": \"{{password_organizador}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "0.3 Login comprador en Auth (200 + cookie jwt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso (200)', () => pm.response.to.have.status(200));",
                  "const sc = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
                  "const jwt = (sc.match(/jwt=([^;]+)/) || [])[1] || (pm.response.cookies.get && pm.response.cookies.get('jwt'));",
                  "pm.test('Auth entrega la cookie de sesión jwt', () => pm.expect(jwt, 'cookie jwt').to.be.a('string').and.not.empty);",
                  "if (jwt) pm.collectionVariables.set('jwt_comprador', jwt);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_comprador}}\",\n  \"password\": \"{{password_comprador}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
