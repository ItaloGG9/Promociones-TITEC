    {
      "name": "I2. API Gateway — servicios para Entradas y checkout",
      "description": "Todas las llamadas pasan por el API Gateway (/api/promociones/*). POST /evaluar es el servicio que consume Entradas con { id_evento, id_usuario, cantidad_entradas, codigo_promocion }.",
      "item": [
        {
          "name": "2.1 Entradas: código vigente (200, 20%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Evaluación (200)', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Aplica 20% con el código creado', () => { pm.expect(b.porcentaje_descuento).to.eql(20); pm.expect(b.nombre_codigo).to.eql(pm.collectionVariables.get('codigo')); });",
                  "pm.test('Devuelve id_promocion', () => pm.expect(b.id_promocion).to.eql(pm.collectionVariables.get('id_promocion')));"
