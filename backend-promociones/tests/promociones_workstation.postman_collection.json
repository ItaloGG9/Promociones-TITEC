                  "pm.test('Código en mayúsculas y asociado al evento', () => {",
                  "  pm.expect(b.nombre_codigo).to.eql(pm.collectionVariables.get('codigo'));",
                  "  pm.expect(b.id_evento).to.eql(pm.environment.get('id_evento') || pm.collectionVariables.get('id_evento'));",
                  "});",
                  "pm.test('Stock inicial 50 y sin usos', () => { pm.expect(b.cantidad_codigos).to.eql(50); pm.expect(b.usos_actuales).to.eql(0); });",
