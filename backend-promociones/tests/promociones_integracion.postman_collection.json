      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_codigo\": \"OFERTA2026\",\n  \"id_evento\": \"evt-123\",\n  \"porcentaje_descuento\": 15,\n  \"fecha_inicio\": \"2026-09-01T00:00:00Z\",\n  \"fecha_fin\": \"2026-12-31T23:59:59Z\",\n  \"cantidad_codigos\": 50\n}"
        },
        "url": {
          "raw": "http://localhost:3005/api/v1/promociones",
          "protocol": "http",
          "host": ["localhost"],
