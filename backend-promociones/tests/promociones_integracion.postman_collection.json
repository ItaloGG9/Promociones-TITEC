              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Checkout - Validar Código Vigente (200 OK)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_evento\": \"evt-123\",\n  \"cantidad_entradas\": 2,\n  \"precio_base\": 15000,\n  \"usuario\": {\n    \"id_usuario\": \"usr-999\",\n    \"rol_usuario\": \"cliente\"\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3005/promociones/validar/DESC50",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3005",
          "path": ["promociones", "validar", "DESC50"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Codigo es valido con 50% de descuento', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.valido).to.eql(true);",
              "    pm.expect(data.porcentaje_descuento).to.eql(50);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Checkout - Validar Código Expirado (400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_evento\": \"evt-123\",\n  \"cantidad_entradas\": 2,\n  \"precio_base\": 15000,\n  \"usuario\": {\n    \"id_usuario\": \"usr-999\",\n    \"rol_usuario\": \"cliente\"\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3005/promociones/validar/EXPIRADO30",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3005",
          "path": ["promociones", "validar", "EXPIRADO30"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Valido es false por expiración', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.valido).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
