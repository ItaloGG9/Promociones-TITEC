      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna porcentaje de descuento mayor a 0', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.porcentaje_descuento).to.be.above(0);",
              "});"
