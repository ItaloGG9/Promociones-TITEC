  },
  "item": [
    {
      "name": "1. Listar Promociones por Evento (200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3005/api/v1/promociones/evento/evt-123",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3005",
          "path": ["api", "v1", "promociones", "evento", "evt-123"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna un arreglo de promociones', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
