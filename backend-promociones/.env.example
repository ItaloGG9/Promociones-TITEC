# Copiar como .env si quieres personalizar valores. Los valores por defecto
# del docker-compose.yml permiten trabajar en la red Docker de TicketU.
PORT=3000
MONGO_URI=mongodb://mongo-promociones:27017/promociones_db
BROKER_URL=amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu
EVENT_EXCHANGE=ticketu.events
AUTH_SERVICE_URL=http://ticketu-auth:3001/api/v1/auth
CATALOGO_SERVICE_URL=http://ticketu-catalogo:4001
ENTRADAS_SERVICE_URL=http://ticketu-entradas:4002
PAGOS_SERVICE_URL=http://ticketu-pagos:4003
HTTP_TIMEOUT_MS=5000
